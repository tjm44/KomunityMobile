# ============================================================
# KomunityMobile — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# EXPO_PUBLIC_* variables are inlined at build time by Expo
# and are safe to reference in client-side code.
# ============================================================

# --- API Base URL ---
# For local dev:   leave blank (auto-detected from Expo host IP)
# For production:  set to your VPS / cloud API URL
EXPO_PUBLIC_API_URL=
# Example production value:
# EXPO_PUBLIC_API_URL=https://api.komunity.co.za/api/v1/
